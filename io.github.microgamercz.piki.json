{
    "id": "io.github.microgamercz.piki",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "piki",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets",
        "--filesystem=xdg-run/hypr"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig"
    ],
    "modules": [
        {
            "name": "qtkeychain",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/frankosterfeld/qtkeychain/archive/0.15.0.tar.gz",
                    "sha256": "f4254dc8f0933b06d90672d683eab08ef770acd8336e44dfa030ce041dc2ca22",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 4138,
                        "stable-only": true,
                        "url-template": "https://github.com/frankosterfeld/qtkeychain/archive/$version.tar.gz"
                    }
                }
            ],
            "config-opts": [
                "-DBUILD_TRANSLATIONS=NO",
                "-DBUILD_WITH_QT6=ON"
            ]
        },
        {
            "name": "libportal",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flatpak/libportal",
                    "tag": "0.11.0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    },
                    "commit": "fc4d62cfe131e8494c82f597f92b2234d584c367"
                }
            ],
            "config-opts": [
                "-Ddocs=false",
                "-Dtests=false",
                "-Dvapi=false",
                "-Dbackend-gtk3=enabled",
                "-Dbackend-gtk4=disabled",
                "-Dbackend-qt5=disabled",
                "-Dbackend-qt6=disabled"
            ]
        },
        {
            "name": "piqi",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/MicrogamerCz/Piqi",
                    "tag": "0.3.2"
                }
            ]
        },
        {
            "name": "piki",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/MicrogamerCz/Piki",
                    "tag": "0.5.0"
                }
            ]
        }
    ]
}
