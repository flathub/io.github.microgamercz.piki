{
    "id": "io.github.microgamercz.piki",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "piki",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets",
        "--filesystem=xdg-run/hypr"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig"
    ],
    "modules": [
        {
            "name": "qtkeychain",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/frankosterfeld/qtkeychain",
                    "tag": "0.17.0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    },
                    "commit": "875f77d9f61bd97fd84cca47ce3bc71186dfbd09"
                }
            ],
            "config-opts": [
                "-DBUILD_TRANSLATIONS=NO",
                "-DBUILD_WITH_QT6=ON"
            ]
        },
        {
            "name": "libportal",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flatpak/libportal",
                    "tag": "0.11.0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    },
                    "commit": "fc4d62cfe131e8494c82f597f92b2234d584c367"
                }
            ],
            "config-opts": [
                "-Ddocs=false",
                "-Dtests=false",
                "-Dvapi=false",
                "-Dbackend-gtk3=enabled",
                "-Dbackend-gtk4=disabled",
                "-Dbackend-qt5=disabled",
                "-Dbackend-qt6=disabled"
            ]
        },
        {
            "name": "piqi",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/MicrogamerCz/Piqi",
                    "tag": "0.3.2",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    },
                    "commit": "f9d89d4460c961296b285bd39a895368d39343fd"
                }
            ]
        },
        {
            "name": "piki",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/MicrogamerCz/Piki",
                    "tag": "0.5.0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    },
                    "commit": "6463d5d45dd8746f5a5b119bfd095267c16d5a75"
                }
            ]
        }
    ]
}
